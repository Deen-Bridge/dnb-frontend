# Firebase Web SDK config values (not secrets, but environment-specific)
# NODE_ENV=production
DNB_API_URL=https://dnb-backend-api.onrender.com
NEXT_PUBLIC_API_URL=https://dnb-backend-api.onrender.com
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ─── Liveness / Face-Verification ─────────────────────
# Which verification adapter to load: "mock" | "persona" | "onfido"
# Use "mock" for local development and tests — no vendor SDK required.
# Switch to "persona" or "onfido" (config + adapter only, no UI changes needed).
NEXT_PUBLIC_LIVENESS_PROVIDER=mock

# Consent policy version — bump when the disclosure text changes so existing
# consent records remain distinguishable from new ones.
NEXT_PUBLIC_LIVENESS_CONSENT_VERSION=1.0.0

# Seconds a single capture attempt may run before timing out (default: 60).
NEXT_PUBLIC_LIVENESS_TIMEOUT_SECONDS=60

# NOTE: vendor API keys (Persona / Onfido secret keys) must NEVER use the
# NEXT_PUBLIC_ prefix — they belong on the server only.
# PERSONA_API_KEY=<server-side secret>
# ONFIDO_API_TOKEN=<server-side secret>
