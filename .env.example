# Web app environment: copy this file to .env.local and replace values only
# when you need a non-default service or deployment.

# Public site origin used for metadata, Open Graph, sitemap, and robots URLs.
# Optional. Defaults to Vercel's deployment URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Public service URLs. Optional; defaults are localhost:5001 (API) and
# localhost:8000 (AI service).
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AI_API_URL=http://localhost:8000

# Secret shared with dnb-ai for streaming chat. Server-only; never use NEXT_PUBLIC_.
# Required for the streaming AI endpoint; there is no safe production default.
AI_SERVICE_API_KEY=

# Stellar network for client transactions. Optional; defaults to testnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Optional donation receiver address; blank disables the configured-wallet display.
NEXT_PUBLIC_DONATION_WALLET=

# Browser push. Both values are public keys; keep private VAPID keys on the backend.
# Optional; push subscription is unavailable until configured.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Cloudinary uploads. Public cloud name is needed for unsigned media uploads.
# Private credentials below are only needed by the signed-document URL endpoint.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional; signed URLs default to 60 seconds.
SIGNED_URL_EXPIRATION_SECONDS=60

# Jitsi video rooms. Optional defaults: meet.jit.si and JWT disabled.
NEXT_PUBLIC_JITSI_DOMAIN=https://meet.jit.si
NEXT_PUBLIC_JITSI_REQUIRE_JWT=false

# Firebase Web SDK configuration. Public client identifiers, not server secrets.
# Optional; the app falls back to its built-in project configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Face verification. Optional defaults: mock provider, consent version 1.0.0,
# and 60-second timeout. Persona/Onfido secret credentials belong server-side.
NEXT_PUBLIC_LIVENESS_PROVIDER=mock
NEXT_PUBLIC_LIVENESS_CONSENT_VERSION=1.0.0
NEXT_PUBLIC_LIVENESS_TIMEOUT_SECONDS=60
# PERSONA_API_KEY=
# ONFIDO_API_TOKEN=

# Optional tooling and observability settings.
ANALYZE=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional. Needed only to upload source maps to Sentry.
SENTRY_AUTH_TOKEN=
# Playwright's local server port; defaults to 3123.
E2E_PORT=3123
# NODE_ENV is managed by Next.js. VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL,
# and VERCEL_ENV are supplied by Vercel; do not set these locally.
# Never put secrets in NEXT_PUBLIC_* variables. In particular, do not define
# NEXT_PUBLIC_CLOUDINARY_API_SECRET; use CLOUDINARY_API_SECRET server-side.

# Expo mobile app environment: place these in mobile/.env when using the app.
# Defaults: localhost:5000, localhost:8000, testnet, and https://meet.jit.si.
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_AI_API_URL=http://localhost:8000
EXPO_PUBLIC_STELLAR_NETWORK=testnet
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_JITSI_DOMAIN=https://meet.jit.si
