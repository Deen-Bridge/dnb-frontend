{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_ENV": "development",
        "IOS_BUNDLE_IDENTIFIER": "com.deenbridge.app.dev",
        "ANDROID_PACKAGE": "com.deenbridge.app.dev",
        "EXPO_PUBLIC_BUILD_PROFILE": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_ENV": "preview",
        "IOS_BUNDLE_IDENTIFIER": "com.deenbridge.app.preview",
        "ANDROID_PACKAGE": "com.deenbridge.app.preview",
        "EXPO_PUBLIC_BUILD_PROFILE": "preview"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "APP_ENV": "production",
        "IOS_BUNDLE_IDENTIFIER": "com.deenbridge.app",
        "ANDROID_PACKAGE": "com.deenbridge.app",
        "EXPO_PUBLIC_BUILD_PROFILE": "production"
      },
      "ios": {
        "autoIncrement": true,
        "appleId": "$EXPO_APPLE_ID",
        "ascAppId": "$EXPO_ASC_APP_ID",
        "appleTeamId": "$EXPO_APPLE_TEAM_ID"
      },
      "android": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "$EXPO_APPLE_ID",
        "ascAppId": "$EXPO_ASC_APP_ID",
        "appleTeamId": "$EXPO_APPLE_TEAM_ID"
      }
    }
  }
}
